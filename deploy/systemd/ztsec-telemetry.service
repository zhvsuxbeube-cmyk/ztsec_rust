[Unit]
Description=ZTSEC Python telemetry application
Requires=ztsec-server.service
After=ztsec-server.service

[Service]
Type=simple
User=ztsec
Group=ztsec
Environment=ZTSEC_IPC_SOCKET=/run/ztsec/telemetry.sock
ExecStart=/usr/bin/python3 /opt/ztsec/telemetry_service.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ztsec

[Install]
WantedBy=multi-user.target
